# Shopify embedded runtime. Production values are configured in Vercel.
# SHOPIFY_API_SECRET and the encryption key are Secrets; never commit values.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://embedded.adstable.app
SCOPES=
ADSTABLE_SESSION_ENCRYPTION_KEY_V1=

# Server-only Shopify Partner API runtime contract.
# Production values are configured in Vercel; never commit the access token.
SHOPIFY_PARTNER_ORG_ID=
SHOPIFY_PARTNER_API_ACCESS_TOKEN=
SHOPIFY_APP_GID=

# Server-only Supabase transaction-pooler URL for the function-only
# adstable_runtime role. Store as a Vercel Secret; never use NEXT_PUBLIC_.
ADSTABLE_RUNTIME_DATABASE_URL=
