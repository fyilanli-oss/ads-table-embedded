    ],
    "klaviyo_campaign": [
      "campaign",
      "campaign_message",
      "variation_only_when_verified"
    ],
    "klaviyo_flow": [
      "flow",
      "flow_message",
      "variation_only_when_verified"
    ]
  },
  "forbidden": [
    "synthetic_Google_ad_for_Shopping_or_Performance_Max",
