  "product_intent": "Give a Shopify merchant a fast Platform-to-Channel path for cost, sold products, product burden and additional basket products while preserving provider-native truth.",
  "user_facing_term": {
    "label": "Channel",
    "meaning": "a derived display path composed only from real provider-native entities",
    "provider_entity": false,
    "canonical_dataset_entity_type": false,
    "independently_persisted_source_fact": false,
    "synthetic_id_allowed": false
  },
  "collision_prevention": {
    "delivery_medium_key": "delivery_channel",
    "delivery_medium_examples": [
      "email",
      "sms",
      "mms",
      "whatsapp",
      null
    ],
    "canonical_identity_field_named_channel_forbidden": true,
    "UI_Channel_must_not_overwrite_delivery_channel": true,
    "provider_native_channel_fields_remain_namespaced_raw_evidence": true
  },
  "source_path_contract": {
    "every_node_requires_provider_native_type_id_and_name": true,
    "unsupported_or_missing_node_must_not_be_created": true,
    "one_common_leaf_type_required": false,
    "same_display_name_never_collapses_identity": true,
    "derived_label_recomputable_from_native_nodes": true
  },
  "provider_examples": {
    "meta": [
      "campaign",
      "adset",
      "ad"
    ],
    "google_search": [
      "campaign",
      "ad_group",
      "ad"
    ],
