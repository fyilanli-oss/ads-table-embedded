  "capacity_envelope": {
    "platform_has_fixed_workspace_limit": false,
    "capacity_unit": "measured_workload_envelope_not_workspace_count_alone",
    "target_certified_active_workspaces": 2000,
    "stress_test_workspaces": 4000,
    "two_thousand_workspace_scheduler_math": {
      "workspace_refresh_starts_per_hour": 2000,
      "average_workspace_starts_per_second": 0.556,
      "three_provider_jobs_per_day": 144000,
      "average_three_provider_job_starts_per_second": 1.667
    },
    "mandatory_workload_budget_fields": [
      "provider_rows_per_refresh",
      "database_rows_written_per_refresh",
      "bytes_written_per_refresh",
      "deep_reconciliation_amplification",
      "interactive_query_rate",
      "concurrent_export_rate",
      "retention_growth_per_workspace"
    ],
    "scheduler_rules": {
      "top_of_hour_fanout_forbidden": true,
      "uniform_sharding_across_hour": true,
      "lease_and_single_flight": true,
      "bounded_provider_and_database_concurrency": true,
      "backpressure_and_retry_jitter": true,
      "hourly_cycle_completion_target_minutes": 45,
      "reserve_before_next_cycle_minutes": 15
    },
    "query_and_export_rules": {
      "workspace_and_date_bounded_queries": true,
      "composite_indexing_from_measured_query_shapes": true,
      "aggregate_first_ui_queries": true,
      "unbounded_scans_forbidden": true,
      "export_is_async_when_introduced": true,
      "export_uses_cursor_paging_and_bounded_snapshot": true,
      "export_competes_with_primary_interactive_pool": false,
      "large_export_file_has_retention_expiry": true
    },
    "acceptance_tests": {
      "before_A6_EO_05": [
        "workload_budget_contract",
        "index_and_query_plan_baseline"
      ],
      "A6_EO_05": [
        "2000_workspace_hourly_scheduler_test",
        "4000_workspace_compressed_stress_test",
        "24_hour_2000_workspace_soak"
      ],
      "A6_EO_06": [
        "summary_daily_compare_table_query_characterization",
        "export_load_characterization_before_export_release"
      ],
      "A6_EO_08": [
        "production_shape_restore_and_load_rehearsal"
      ]
    },
    "pass_thresholds": {
      "refresh_cycle_p95_minutes_lte": 45,
      "interactive_read_p95_ms_lte": 2000,
      "interactive_read_p99_ms_lte": 5000,
      "job_or_query_error_rate_percent_lt": 0.1,
      "tenant_isolation_failures": 0,
      "sustained_cpu_percent_lt": 60,
      "peak_cpu_percent_lt": 80,
      "sustained_memory_percent_lt": 70,
      "database_connection_limit_utilization_percent_lt": 60,
      "recommended_database_size_utilization_percent_lt": 70,
      "disk_io_throttling_events": 0,
      "steady_state_disk_io_budget_use": "none_expected_any_use_triggers_upgrade_review",
      "capacity_headroom_percent_gte": 30
    },
    "certified_capacity_rule": "production_admission_limit_must_not_exceed_latest_passed_capacity_with_required_headroom",
    "scale_review_trigger_percent_of_certified_capacity": 80,
    "no_unbounded_onboarding_beyond_certified_capacity": true,
    "scaling_ladder": [
      "query_index_batch_and_retention_optimization",
      "larger_Supabase_compute",
      "provisioned_disk_IOPS_or_throughput",
      "read_replica_for_analysis_and_export",
      "separate_operational_control_plane_from_analytical_fact_workload",
      "portable_Postgres_migration_only_after_measured_business_and_operational_decision"
    ],
    "read_replica_limits": {
      "purpose": "read_only_analysis_and_export",
      "asynchronous_replication_lag_must_be_visible": true,
      "writes_remain_on_primary": true
