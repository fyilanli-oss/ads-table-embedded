{
  "schemaVersion": 1,
  "scanRoots": [
    "app",
    "src",
    "server",
    "scripts"
  ],
  "forbiddenDirectDependencies": [
    "express",
    "googleapis",
    "@supabase/supabase-js",
    "@prisma/client",
    "prisma",
    "@shopify/shopify-app-session-storage-prisma"
  ],
  "forbiddenRuntimeTokens": [
    "ga4",
    "google_sheets",
    "tiktok",
    "pinterest",
    "organic_provider",
    "platform_connection_tokens",
    "shopify_workspace_provider_connections",
    "user_id",
    "dual_write",
    "live_shadow",
    "controlled_acceptance",
    "historical_inventory"
  ],
  "forbiddenRouteTokens": [
    "debug",
    "operator",
    "diagnostic",
    "acceptance"
  ],
  "allowedProviderProtocolTokenOccurrences": [
    {
      "file": "app/lib/providers/meta-graph.server.js",
      "token": "debug",
      "reason": "official_Meta_debug_token_protocol_endpoint_not_a_product_or_operator_route"
    },
    {
      "file": "app/lib/refresh/quota-native-fetch.server.js",
      "token": "debug",
      "reason": "exact_Meta_outbound_debug_token_allowlist_not_a_new_product_or_operator_route"
    },
    {
      "file": "app/lib/refresh/quota-scope-resolver.server.js",
      "token": "debug",
      "reason": "existing_Meta_token_debug_endpoint_family_exact_scope_match_not_new_UI_or_operator_route"
    }
  ],
  "forbiddenPaths": [
    "public",
    "server.js"
  ],
  "allowedEnvironmentKeys": [
    "ADSTABLE_RUNTIME_DATABASE_URL",
    "ADSTABLE_SESSION_ENCRYPTION_KEY_V1",
    "META_APP_ID",
    "META_APP_SECRET",
    "META_GRAPH_VERSION",
    "META_OAUTH_REDIRECT_URI",
    "SCOPES",
    "SHOPIFY_API_KEY",
    "SHOPIFY_API_SECRET",
    "SHOPIFY_APP_GID",
    "SHOPIFY_APP_URL",
    "SHOPIFY_PARTNER_API_ACCESS_TOKEN",
    "SHOPIFY_PARTNER_ORG_ID"
  ],
  "requiredActivePolarisRuntime": "polaris-2.0-rc.js",
  "forbiddenObsoletePolarisRuntime": "polaris-1.js",
  "allowedProductRoutes": [
    "/",
    "/ad-analysis",
    "/settings"
  ],
  "reservedSystemRoutePrefixes": [
    "/auth",
    "/webhooks"
  ]
}
