    "klaviyo": {
      "connected_account_cardinality": 1,
      "control_label": "Connected Account",
      "reporting_account_control": false,
      "account_change_requires_reauthorization_lifecycle": true
    }
  },
  "persistence": {
    "connection_table": "integrations.provider_connections",
    "connected_accounts_table": "integrations.provider_accounts",
    "reporting_history_table": "integrations.reporting_account_bindings",
    "one_connection_per_install_generation_provider": true,
    "one_active_reporting_binding_per_connection": true,
    "historical_reporting_binding_preserved": true,
    "credential_reference_bound_to_exact_installation_generation_provider": true,
    "forced_rls": true,
    "direct_table_access": false,
    "function_only": true,
    "security_definer_empty_search_path": true,
    "forced_rls_owner_policy_role": "adstable_owner",
    "composite_foreign_keys_have_covering_indexes": true
