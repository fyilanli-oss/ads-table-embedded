    "scope": [
      "workspace_id",
      "install_generation"
    ],
    "mutable_by_provider": false,
    "mutable_by_reporting_account": false,
    "second_shop_behavior": "separate Shopify installation, workspace and subscription",
    "non_shopify_commerce_source_allowed": false
  },
  "reporting_store_control_exists": false,
  "provider_evidence": {
    "required_authority": "provider_account_access_verified",
    "maximum_age_minutes": 10,
    "raw_provider_response_persisted": false,
    "token_or_credential_persisted_in_account_rows": false,
    "future_producer": "EO-04 provider adapters",
    "unverified_or_stale_behavior": "fail_closed"
  },
  "provider_rules": {
    "meta": {
      "connected_account_cardinality": {
        "minimum": 1,
        "maximum": 3
      },
      "reporting_account_cardinality": 1,
      "reporting_account_must_be_connected": true,
      "reporting_account_must_be_provider_reverified": true
    },
    "google_ads": {
      "connected_account_cardinality": {
        "minimum": 1,
        "maximum": 3
      },
      "reporting_account_cardinality": 1,
      "reporting_account_must_be_connected": true,
      "reporting_account_must_be_provider_reverified": true,
      "manager_access_path_preserved_as": "login_account_id",
      "manager_account_reporting_eligible": false
