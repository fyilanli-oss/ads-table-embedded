      "metrics.cross_sell_gross_profit_micros"
    ],
    "clicked_and_sold_product_dimensions_together_for_shopping_click_attribution": true,
    "documented_cart_data_segmenting_resources": [
      "campaign",
      "ad_group"
    ],
    "individual_standard_ad_sold_product_mapping_guaranteed": false,
    "performance_max_individual_ad_exists": false,
    "performance_max_advertised_product_routes": [
      "shopping_performance_view",
      "asset_group_product_group_view"
    ],
    "advertised_product_performance_is_not_sold_basket_cross_sell_proof": true,
    "merchant_item_id_assumed_shopify_sku_or_variant": false,
    "deterministic_merchant_item_to_installed_shop_product_variant_mapping_required": true,
    "deeper_official_field_compatibility_and_live_query_required": true,
    "exact_live_fixtures": [
      "clicked_product_not_purchased_with_cross_sell",
