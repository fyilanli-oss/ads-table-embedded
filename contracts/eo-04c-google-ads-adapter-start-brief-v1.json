        "all_products_brand_category_or_custom_label_group_is_not_item_identity": true,
        "product_item_is_not_a_Google_ad": true
      },
      "sold_product_cart": {
        "resource": "cart_data_sales_view",
        "native_grain": [
          "campaign_or_ad_group",
          "sold_product",
          "source_date"
        ],
        "sold_identity_fields": [
          "segments.product_sold_item_id",
          "segments.product_sold_title"
        ],
        "advertised_identity_fields_when_applicable": [
          "segments.product_item_id",
          "segments.product_title"
        ],
        "supported_quantity_and_value_metrics": [
          "metrics.units_sold",
          "metrics.revenue_micros",
          "metrics.lead_units_sold",
          "metrics.lead_revenue_micros",
          "metrics.cross_sell_units_sold",
          "metrics.cross_sell_revenue_micros"
        ],
        "ad_id_compatible": false,
        "asset_group_id_compatible": false,
        "units_sold_must_not_be_relabelled_purchase": true
      }
    },
