          "metrics.clicks",
          "metrics.cost_micros",
          "metrics.conversions",
          "metrics.conversions_value",
          "metrics.orders",
          "metrics.units_sold",
          "metrics.revenue_micros"
        ],
        "product_item_is_not_a_Google_ad": true
      },
      "performance_max_retail_product_performance": {
        "resources": [
          "asset_group_product_group_view",
          "asset_group_listing_group_filter"
        ],
        "native_grain_when_item_partition_exists": [
          "campaign",
          "asset_group",
          "product_item",
          "source_date"
        ],
        "item_identity_field": "asset_group_listing_group_filter.case_value.product_item_id.value",
