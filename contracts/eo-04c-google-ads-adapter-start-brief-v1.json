{
  "contract_id": "eo-04c-google-ads-adapter-start-brief-v1",
  "version": "1.0.0",
  "status": "Start_brief_accepted_repository_implementation_pending",
  "checked_at": "2026-10-10",
  "parent": "A6-EO-04",
  "package": "A6-EO-04-C",
  "objective": "Freeze the current official Google Ads account authority, Standard and Performance Max hierarchy, ten canonical Funnel metric mappings, conversion semantics, time/currency, paging, quota, error and product/cart-data evidence boundaries before repository implementation.",
  "depends_on": {
    "package": "A6-EO-04-A",
    "status": "Accepted"
  },
  "authority": {
    "commerce_scope": "verified_installed_shopify_store_and_active_installation_generation",
    "reporting_accounts": {
      "minimum": 1,
      "maximum": 3,
      "type": "provider_verified_advertiser_serving_account",
      "customer_manager_must_be_false": true
    },
    "manager_account_selectable": false,
    "manager_account_reporting_eligible": false,
    "manager_access_path_may_be_retained_as": "login_customer_id_only",
    "browser_account_identity_is_authority": false,
    "merchant_selectable_reporting_store": false,
    "provider_account_can_change_installed_shop": false,
    "ambiguous_cross_store_rows_publishable": false
  },
  "api": {
    "implementation_baseline": "v25",
    "v26_recheck_required_before_repository_or_live_implementation_if_released": true,
    "official_node_client_available": false,
    "planned_transport": "direct_REST_with_strict_contract",
    "oauth_scope": "https://www.googleapis.com/auth/adwords",
    "offline_access_required": true,
    "developer_token_required": false,
    "developer_token_sunset_date": "2026-09-09",
    "access_level_authority": "Google_Cloud_project_owning_OAuth_credentials"
  },
  "hierarchy": {
    "standard": [
      "advertiser_account",
      "campaign",
      "ad_group",
      "ad",
      "source_date"
    ],
    "performance_max": [
      "advertiser_account",
      "campaign",
      "asset_group",
      "source_date"
    ],
    "performance_max_individual_ad_performance_available": false,
    "synthetic_ad_leaf_for_performance_max_forbidden": true
  },
  "canonical_mapping": {
    "impression": {
      "source": "metrics.impressions",
      "status": "supported_when_returned"
    },
    "ad_click": {
      "source": "metrics.clicks",
      "status": "supported_when_returned",
      "session_equivalent": false
    },
    "session": {
      "source": null,
      "status": "unsupported"
    },
    "spend_value": {
      "source": "metrics.cost_micros",
      "transform": "divide_by_1000000",
      "status": "supported_when_returned"
    },
    "add_to_cart": {
      "category": "ADD_TO_CART",
      "metric": "metrics.all_conversions"
    },
    "add_to_cart_value": {
      "category": "ADD_TO_CART",
      "metric": "metrics.all_conversions_value"
    },
    "checkout": {
      "category": "BEGIN_CHECKOUT",
      "metric": "metrics.all_conversions"
    },
    "checkout_value": {
      "category": "BEGIN_CHECKOUT",
      "metric": "metrics.all_conversions_value"
    },
    "purchase": {
      "category": "PURCHASE",
      "metric": "metrics.all_conversions"
    },
    "purchase_value": {
      "category": "PURCHASE",
      "metric": "metrics.all_conversions_value"
    }
  },
  "conversion_semantics": {
    "primary_only_metrics": [
      "metrics.conversions",
      "metrics.conversions_value"
    ],
    "canonical_funnel_metrics": [
      "metrics.all_conversions",
      "metrics.all_conversions_value"
    ],
    "reason": "Funnel actions may be secondary and therefore absent from the primary Conversions column.",
    "blind_all_conversions_sum_forbidden": true,
    "required_segments": [
      "segments.conversion_action",
      "segments.conversion_action_category",
      "segments.conversion_action_name",
      "segments.conversion_attribution_event_type"
    ],
    "attribution_event_types": [
      "INTERACTION",
      "ENGAGED_VIEW",
      "IMPRESSION",
      "UNKNOWN",
      "UNSPECIFIED"
    ],
    "action_identity_and_attribution_type_preserved": true
  },
  "zero_and_missing": {
    "explicit_provider_numeric_zero": "zero",
    "successful_segmented_response_without_row": "absent_until_query_completeness_and_scope_prove_real_zero",
    "unsupported_field": "unsupported",
    "missing_conversion_configuration": "account_configuration_missing",
    "all_selected_metrics_zero_rows_may_be_omitted": true,
    "absent_or_empty_becomes_numeric_zero": false,
    "failed_or_partial_attempt_publishable": false
  },
  "time_currency": {
    "source_timezone": "customer.time_zone",
    "source_currency": "customer.currency_code",
    "source_date": "segments.date_in_customer_timezone",
    "default_conversion_reporting_date": "ad_interaction_date",
    "conversion_occurrence_evidence": [
      "metrics.all_conversions_by_conversion_date",
      "metrics.all_conversions_value_by_conversion_date"
    ],
    "dataset_primary_date_semantics": "interaction_date_for_Google_Ads_Manager_comparability",
    "installed_shop_business_date_normalization_owner": "A6-EO-05",
    "adapter_fx_allowed": false
  },
  "paging_quota_error": {
    "search_page_size_max": 10000,
    "next_page_token_opaque": true,
    "same_exact_query_required_for_next_page": true,
    "page_token_approximate_ttl_hours": 2,
    "valid_next_page_requests_additional_operation_cost": false,
    "large_result_transport": "SearchStream",
    "grpc_response_limit_mb": 64,
    "request_id_evidence_required": true,
    "bounded_retry_statuses": [
      "UNAVAILABLE",
      "DEADLINE_EXCEEDED",
      "INTERNAL",
      "UNKNOWN",
      "ABORTED"
    ],
    "resource_exhausted_behavior": "wait_reduce_rate_and_apply_bounded_retry_policy",
    "never_blind_retry": [
      "authentication",
      "revoked_token",
      "permission",
      "validation",
      "unsupported_field",
      "malformed_query",
      "deterministic_account_scope_failure"
    ]
  },
  "freshness_finality": {
    "click_impression_cost_slo": "approximately_1_hour",
    "google_ads_last_click_conversion_typical_delay": "approximately_3_hours",
    "google_ads_non_last_click_conversion_typical_delay": "up_to_15_hours",
    "ga_imported_last_click_typical_delay": "approximately_12_hours",
    "ga_imported_other_models_typical_delay": "approximately_24_hours",
    "conversion_window": "per_conversion_action_1_to_90_days_depending_on_source",
    "single_fixed_google_finality_window_allowed": false,
    "reconciliation_owner": "A6-EO-05"
  },
  "product_cart_data": {
