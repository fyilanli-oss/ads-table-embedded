  "multi_lane_refresh_design_2026_11_21": {
    "document": "docs/EO_05A_MULTI_LANE_REFRESH_DESIGN.md",
    "status": "owner_approved_single_shop_lane_design_integration_and_acceptance_pending",
    "ownership": "One shared atomic owner and monotonic ownership fence per canonical Shopify shop. The active installation generation is checked inside that ownership scope. Provider, account, day, old generation and data database do not create competing lane ownership. All supported provider refresh jobs use the same current lane.",
    "dispatch": "Verify the current lane, ownership fence, work fence, authority, request identity and shared quota immediately before each new provider request. Record the unique outbound intent before sending, and keep it open through the known outcome. Repeated delivery cannot create a second dispatch right. Shared-control failure blocks new calls. Network calls do not hold a database write transaction open.",
    "handoff": "Freeze new sends, reconcile outstanding dispatches and writes, verify terminal evidence and completed receipts, then atomically transfer ownership with a higher fence. An expired deadline, lost heartbeat or interrupted worker alone does not authorize transfer or retransmission. Other eligible shops can continue within remaining capacity.",
    "quota": "Use the highest published production access as the design baseline while enforcing Google project/customer, Klaviyo installed app/account and endpoint, Meta application/account, and Shopify Partner client scope across every lane. The usable lane count remains measured rather than fixed by this design.",
    "multiple_databases": "Shared authority governs lane and the single active data destination. Freeze and fence the old destination and reconcile outstanding writes before verified destination switch. Unknown and partial transfers keep the shop paused. Database-local locks and counters cannot grant independent dispatch authority.",
    "evidence_boundary": "40.621 seconds measures one serial lane and one synthetic shop. Multi-lane races, dispatch fences, queue redelivery, target migration, and live provider capacity require separate acceptance.",
    "authorization": {"runtime": false, "live_provider": false, "live_database": false, "deployment": false, "merge": false},
    "official_checked_at": "2026-11-21",
    "official_sources": ["https://www.postgresql.org/docs/17/explicit-locking.html", "https://developers.google.com/google-ads/api/docs/productionize/rate-limits", "https://developers.klaviyo.com/en/docs/rate_limits_and_error_handling", "https://developers.facebook.com/docs/graph-api/overview/rate-limiting/#ads-insights", "https://shopify.dev/docs/api/partner/latest#rate-limits", "https://supabase.com/docs/guides/database/postgres/row-level-security"]
  },
  "shared_three_provider_refresh_rehearsal_2026_11_21": {
    "scope": "One isolated PostgreSQL rollback run, one Shopify installation, and one fully closed UTC business day. One real inventory tick queues Google Ads, Klaviyo and Meta under one budget and one concurrent claim. The test coordinator drains that tick serially in Google Ads, Klaviyo, Meta order, with fresh SQL admission and fencing for each job. The second and third drains consume the already verified tick receipt and load current preflight snapshots. There is no scheduler frequency claim.",
    "acceptance": "Each provider writes exactly 1,000 Dataset facts in five 200-row packages with its own verified Shopify mapping, consumer receipt and completed job. All three completions, receipts and 3,000 facts coexist and share the same day and installation in the isolated transaction. Provider quota debits and three Shopify Partner entitlement quota debits are verified in actual PostgreSQL. A missing or shortened fifth Meta package remains an independently checked rejection.",
